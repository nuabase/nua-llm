{
  "compilerOptions": {
    "target": "es2021",
    "module": "ESNext",
    "lib": ["ES2021"],
    "moduleDetection": "force",
    "isolatedModules": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.test.ts", "**/__tests__/**"]
}
