{
  "name": "nua-llm-core",
  "version": "1.0.0",
  "private": true,
  "description": "Nua LLM Core Library",
  "packageManager": "pnpm@10.20.0",
  "exports": {
    ".": "./src/index.ts",
    "./local-agent": "./src/local-agent.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='integration'",
    "test:integration": "jest --testPathPattern='integration' --testPathIgnorePatterns='/node_modules/' --testTimeout=30000",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.5.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "zod": "^4.6.7"
  }
}
