{
  "name": "nua-llm-core",
  "version": "1.0.0",
  "description": "Nua LLM Core Library",
  "packageManager": "pnpm@10.20.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-agent": {
      "types": "./dist/local-agent.d.ts",
      "default": "./dist/local-agent.js"
    }
  },
  "typesVersions": {
    "*": {
      "local-agent": [
        "dist/local-agent.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='integration'",
    "test:integration": "jest --testPathPattern='integration' --testPathIgnorePatterns='/node_modules/' --testTimeout=30000",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.5.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
