{
  "name": "@nuabase/gateway",
  "description": "Client for the hosted Nuabase API: typed functions from LLM prompts, with caching, request tracking and async jobs",
  "packageManager": "pnpm@10.20.0",
  "version": "0.0.0",
  "type": "module",
  "author": "Jasim A Basheer <jasim@nuabase.com>",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typescript",
    "nuabase",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuabase/nua-llm.git",
    "directory": "nua-gateway"
  },
  "bugs": {
    "url": "https://github.com/nuabase/nua-llm/issues"
  },
  "homepage": "https://github.com/nuabase/nua-llm/tree/main/nua-gateway#readme",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/types/index.d.cts",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.1.5"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c rollup.config.js",
    "pack:test": "tsx scripts/pack-test",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "jest": "jest",
    "test": "pnpm run prettier:check && pnpm run typecheck && pnpm run lint && pnpm run jest && pnpm run build && pnpm run pack:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "@types/signale": "^1",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.1.1",
    "signale": "^1.4.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "zod": "^4.1.5",
    "zx": "^8.8.1"
  }
}
