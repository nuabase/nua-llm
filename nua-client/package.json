{
  "name": "nuabase",
  "description": "Nuabase TypeScript client to create typed functions from LLM prompts",
  "packageManager": "pnpm@10.20.0",
  "version": "2.3.11",
  "type": "module",
  "author": "Jasim A Basheer <jasim@nuabase.com>",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typescript",
    "nuabase",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuabase/nua-llm.git",
    "directory": "nua-client"
  },
  "bugs": {
    "url": "https://github.com/nuabase/nua-llm/issues"
  },
  "homepage": "https://github.com/nuabase/nua-llm/tree/main/nua-client#readme",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./local-agent": {
      "import": {
        "types": "./dist/local-agent.d.mts",
        "default": "./dist/esm/local-agent.mjs"
      },
      "require": {
        "types": "./dist/local-agent.d.cts",
        "default": "./dist/cjs/local-agent.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "local-agent": [
        "./dist/local-agent.d.cts"
      ]
    }
  },
  "peerDependencies": {
    "zod": "^4.1.5"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c rollup.config.js",
    "pack:test": "tsx scripts/pack-test",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "jest": "jest",
    "test": "pnpm run prettier:check && pnpm run typecheck && pnpm run lint && pnpm run jest && pnpm run build && pnpm run pack:test",
    "knip": "knip"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.35.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "@types/signale": "^1",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "knip": "^5.63.1",
    "nua-llm-core": "workspace:*",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.1.1",
    "signale": "^1.4.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "zod": "^4.6.7",
    "zx": "^8.8.1"
  }
}
