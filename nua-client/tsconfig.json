{
  "include": ["src", "scripts"],
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "outDir": "temp",
    "declaration": true,
    "declarationMap": false,
    "resolveJsonModule": true,
    "declarationDir": "dist/types",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true
  }
}
